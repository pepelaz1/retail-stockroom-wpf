<Window x:Class="RetailStockDesk.StockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Stockroom — учёт товаров" Width="1210" Height="780" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#2967DC"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#E9F0FC"/><Setter Property="Foreground" Value="#2458B8"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#D8E2EF"/></Style>
    <Style TargetType="DataGrid"><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="39"/><Setter Property="ColumnHeaderHeight" Value="35"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7EDF5"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F9FBFD"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F6F9FD"/><Setter Property="Foreground" Value="#718097"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="9,0"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Window.Resources>
  <Grid Background="#F3F6FA"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#192942"><StackPanel Margin="22,25"><TextBlock Text="▦  stockroom" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#8D9DB6" FontSize="10" FontWeight="Bold" Margin="0,53,0,15"/><Border Background="#2B405E" Padding="12,10" CornerRadius="7"><TextBlock Text="Обзор склада" Foreground="White" FontWeight="SemiBold"/></Border><TextBlock Text="Товары и остатки" Foreground="#BCC7D7" Margin="12,20,0,0"/><TextBlock Text="История операций" Foreground="#BCC7D7" Margin="12,20,0,0"/><TextBlock Text="Локальный прототип" Foreground="#8D9DB6" Margin="0,310,0,0" FontSize="11"/></StackPanel></Border>
    <Grid Grid.Column="1" Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="15"/><RowDefinition Height="85"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="13"/><RowDefinition Height="165"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Управление запасами" FontSize="26" FontWeight="Bold" Foreground="#192942"/><TextBlock Text="Товары, движение и предупреждения на одном экране" Foreground="#718097" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Экспорт CSV" Style="{StaticResource Secondary}" Click="Export_Click" VerticalAlignment="Center"/></Grid>
      <UniformGrid Grid.Row="2" Columns="3"><Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="ТОВАРОВ В КАТАЛОГЕ" Foreground="#718097" FontSize="11"/><TextBlock x:Name="CountText" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="ЕДИНИЦ НА СКЛАДЕ" Foreground="#718097" FontSize="11"/><TextBlock x:Name="UnitsText" FontSize="28" FontWeight="Bold"/></StackPanel></Border><Border Background="#FFF7E9" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="ТРЕБУЮТ ПОПОЛНЕНИЯ" Foreground="#9B651F" FontSize="11"/><TextBlock x:Name="LowText" Foreground="#9B651F" FontSize="28" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="10" Margin="0,0,13,0"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Каталог товаров" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="FilterText" Foreground="#718097" FontSize="11"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" ToolTip="Поиск по артикулу, названию и категории" TextChanged="Search_Changed"/></Grid><DataGrid x:Name="ProductsGrid" Grid.Row="2" AutoGenerateColumns="False" SelectionChanged="Product_Selected"><DataGrid.Columns><DataGridTextColumn Header="АРТИКУЛ" Binding="{Binding Sku}" Width="85"/><DataGridTextColumn Header="ТОВАР" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="КАТЕГОРИЯ" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="ШТ." Binding="{Binding Quantity}" Width="50"/><DataGridTextColumn Header="МИН." Binding="{Binding Minimum}" Width="55"/><DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="92"/></DataGrid.Columns></DataGrid></Grid></Border>
        <Border Grid.Column="1" Background="White" CornerRadius="10"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Движение товара" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="SelectedText" Text="Выберите товар в таблице" Foreground="#718097" Margin="0,5,0,11" TextWrapping="Wrap"/><TextBlock Text="Количество" FontSize="12"/><TextBox x:Name="MoveBox" Text="1" Margin="0,4,0,9"/><TextBlock Text="Комментарий" FontSize="12"/><TextBox x:Name="NoteBox" Margin="0,4,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="+ Приход" Style="{StaticResource Primary}" Click="Receive_Click"/><Button Grid.Column="2" Content="− Расход" Style="{StaticResource Secondary}" Click="Ship_Click"/></Grid><Border Height="1" Background="#E7EDF5" Margin="0,16"/><TextBlock Text="Новый товар" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="Артикул" FontSize="12"/><TextBox x:Name="SkuBox" Margin="0,4,0,7"/><TextBlock Text="Название" FontSize="12"/><TextBox x:Name="NameBox" Margin="0,4,0,7"/><TextBlock Text="Категория" FontSize="12"/><TextBox x:Name="CategoryBox" Margin="0,4,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Остаток" FontSize="12"/><TextBox x:Name="QuantityBox" Text="0" Margin="0,4,0,8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Минимум" FontSize="12"/><TextBox x:Name="MinimumBox" Text="5" Margin="0,4,0,8"/></StackPanel></Grid><Button Content="Добавить в каталог" Style="{StaticResource Primary}" Click="Add_Click"/></StackPanel></ScrollViewer></Border>
      </Grid>
      <Border Grid.Row="6" Background="White" CornerRadius="10"><Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Последние операции" FontSize="16" FontWeight="Bold"/><DataGrid x:Name="HistoryGrid" Grid.Row="2" AutoGenerateColumns="False" RowHeight="28" ColumnHeaderHeight="28"><DataGrid.Columns><DataGridTextColumn Header="ДАТА" Binding="{Binding TimeLabel}" Width="105"/><DataGridTextColumn Header="ТИП" Binding="{Binding Type}" Width="80"/><DataGridTextColumn Header="АРТИКУЛ" Binding="{Binding Sku}" Width="85"/><DataGridTextColumn Header="ТОВАР" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="ШТ." Binding="{Binding Quantity}" Width="50"/><DataGridTextColumn Header="ПРИМЕЧАНИЕ" Binding="{Binding Note}" Width="180"/></DataGrid.Columns></DataGrid></Grid></Border>
    </Grid>
  </Grid>
</Window>

